<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GinRaiDee" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryDark">@color/orange_dark</item>
        <item name="colorAccent">@color/orange_primary</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/orange_primary</item>
    </style>

    <!-- ปุ่มหมวดในหน้า Choice Page -->
    <style name="CategoryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
